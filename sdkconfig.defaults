# Disable IDF Component Manager
CONFIG_IDF_COMPONENT_MANAGER=n

# Disable mbedTLS certificate bundle (not needed for MIDI controller)
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=n

# Use UART0 for console (free the native USB for TinyUSB OTG/MIDI)
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=n

# Enable Bluetooth (NimBLE)
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_INTERNAL=y
CONFIG_BT_NIMBLE_TASK_STACK_SIZE=4096
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=4096
CONFIG_BT_NIMBLE_MSYS1_BLOCK_COUNT=60

# Enable TinyUSB
CONFIG_TINYUSB=y
CONFIG_TINYUSB_CDC_ENABLED=n
CONFIG_TINYUSB_MSC_ENABLED=n
CONFIG_TINYUSB_HID_ENABLED=n
CONFIG_TINYUSB_MIDI_COUNT=1
CONFIG_TINYUSB_DESC_USE_ESPRESSIF_VID=y

# USB Device settings
CONFIG_USB_ENABLED=y
CONFIG_USB_OTG_SUPPORTED=y

# Increase main task stack size (input scan + MIDI + OLED)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# Increase event loop stack
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# Keep BLE bonds across reboots; without this the phone/computer remembers a
# pairing the device has lost and the reconnect fails until it is forgotten.
CONFIG_BT_NIMBLE_NVS_PERSIST=y
